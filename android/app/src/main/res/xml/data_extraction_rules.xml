<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer.
     The database key is wrapped by an Android Keystore key, which never
     leaves the device: a restored wrapped key could not be decrypted. The
     database itself lives in noBackupFilesDir (never backed up). Restoring
     on a new device goes through the account or a `.myos` export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="keyring-default.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="keyring-default.xml" />
    </device-transfer>
</data-extraction-rules>
