{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myos-site",
  "compatibility_date": "2025-01-01",
  // Served on <name>.<account>.workers.dev. For your own domain add a
  // route and set `workers_dev` to false; under a path of a shared domain
  // (with `base` in site.config.json) use `<domain>/<base>*`, without the
  // slash, so the bare path reaches the site too:
  // "routes": [{ "pattern": "example.com/myos*", "zone_name": "example.com" }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
